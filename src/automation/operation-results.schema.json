{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adobe-mcp.local/contracts/operation-results.schema.json",
  "title": "Proposed closed domain result schemas",
  "description": "Registry dataSchemaId selects exactly one $defs result; no generic catch-all operation output. Nested host references/evidence/resources use canonical receipt contract. New operations must add a strict result schema before advertisement.",
  "oneOf": [
    {
      "$ref": "#/$defs/ps.document_info.v1"
    },
    {
      "$ref": "#/$defs/ps.layer_change.v1"
    },
    {
      "$ref": "#/$defs/evidence.capture.v1"
    },
    {
      "$ref": "#/$defs/media.import.v1"
    },
    {
      "$ref": "#/$defs/pr.timeline_edit.v1"
    },
    {
      "$ref": "#/$defs/pr.cut_map.v1"
    },
    {
      "$ref": "#/$defs/transcript.words.v1"
    },
    {
      "$ref": "#/$defs/pr.captions.v1"
    },
    {
      "$ref": "#/$defs/audio.measurement.v1"
    },
    {
      "$ref": "#/$defs/pr.parameter_change.v1"
    },
    {
      "$ref": "#/$defs/export.completed.v1"
    },
    {
      "$ref": "#/$defs/query.inventory.v1"
    },
    {
      "$ref": "#/$defs/batch.completed.v1"
    },
    {
      "$ref": "#/$defs/project.close.v1"
    },
    {
      "$ref": "#/$defs/roles.manifest.v1"
    },
    {
      "$ref": "#/$defs/partial.operation.v1"
    },
    {
      "$ref": "#/$defs/native.batch.v1"
    }
  ],
  "$defs": {
    "tick": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticks": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "ticks"
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/tick"
        },
        "end": {
          "$ref": "#/$defs/tick"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "clipState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clipKey": {
          "type": "string",
          "minLength": 1
        },
        "sourceAssetId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRange": {
          "$ref": "#/$defs/range"
        },
        "timelineRange": {
          "$ref": "#/$defs/range"
        },
        "mediaType": {
          "enum": [
            "video",
            "audio"
          ]
        },
        "trackIndex": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "clipKey",
        "sourceAssetId",
        "sourceRange",
        "timelineRange",
        "mediaType",
        "trackIndex"
      ]
    },
    "ps.document_info.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "enum": [
            "RGB",
            "CMYK",
            "Lab",
            "Grayscale",
            "Bitmap",
            "Indexed",
            "Multichannel",
            "Duotone"
          ]
        },
        "bitDepth": {
          "enum": [
            1,
            8,
            16,
            32
          ]
        },
        "resolutionPpi": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "iccProfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "layerCount": {
          "type": "integer",
          "minimum": 0
        },
        "workingAssetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "documentId",
        "width",
        "height",
        "mode",
        "bitDepth",
        "resolutionPpi",
        "iccProfile",
        "layerCount",
        "workingAssetId"
      ]
    },
    "ps.layer_change.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "affectedLayerIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "changed": {
          "type": "boolean"
        },
        "changeKind": {
          "enum": [
            "create",
            "delete",
            "rename",
            "text",
            "transform",
            "mask",
            "pixels",
            "adjustment",
            "smart_object",
            "group"
          ]
        },
        "bounds": {
          "$ref": "#/$defs/rect"
        },
        "finalName": {
          "type": "string",
          "minLength": 1
        },
        "finalText": {
          "type": "string"
        },
        "maskArtifactId": {
          "type": "string",
          "minLength": 1
        },
        "patchArtifactId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "affectedLayerIds",
        "changed",
        "changeKind"
      ]
    },
    "evidence.capture.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidenceKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "snapshotDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requestedTicks": {
          "$ref": "#/$defs/tick"
        },
        "resolvedTicks": {
          "$ref": "#/$defs/tick"
        },
        "isProxy": {
          "type": "boolean"
        }
      },
      "required": [
        "evidenceKeys",
        "snapshotDigest"
      ]
    },
    "media.import.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inputKey": {
                "type": "string",
                "minLength": 1
              },
              "itemKey": {
                "type": "string",
                "minLength": 1
              },
              "resourceSlot": {
                "type": "string",
                "minLength": 1
              },
              "sourceAssetId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "inputKey",
              "itemKey",
              "resourceSlot",
              "sourceAssetId"
            ]
          },
          "minItems": 1
        },
        "skippedInputKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "items",
        "skippedInputKeys"
      ]
    },
    "pr.timeline_edit.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "before": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clipState"
          },
          "minItems": 0
        },
        "after": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clipState"
          },
          "minItems": 0
        },
        "removedClipKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "linkedClipKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "rippleApplied": {
          "type": "boolean"
        }
      },
      "required": [
        "changed",
        "before",
        "after",
        "removedClipKeys",
        "linkedClipKeys",
        "rippleApplied"
      ]
    },
    "pr.cut_map.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "segmentKey": {
                "type": "string",
                "minLength": 1
              },
              "sourceAssetId": {
                "type": "string",
                "minLength": 1
              },
              "sourceRange": {
                "$ref": "#/$defs/range"
              },
              "timelineRange": {
                "$ref": "#/$defs/range"
              },
              "speedNumerator": {
                "type": "integer",
                "minimum": 1
              },
              "speedDenominator": {
                "type": "integer",
                "minimum": 1
              },
              "reverse": {
                "type": "boolean"
              }
            },
            "required": [
              "segmentKey",
              "sourceAssetId",
              "sourceRange",
              "timelineRange",
              "speedNumerator",
              "speedDenominator",
              "reverse"
            ]
          },
          "minItems": 0
        },
        "mappingArtifactId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "segments",
        "mappingArtifactId"
      ]
    },
    "transcript.words.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceAssetId": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "clock": {
          "enum": [
            "source"
          ]
        },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "word": {
                "type": "string"
              },
              "range": {
                "$ref": "#/$defs/range"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "word",
              "range"
            ]
          },
          "minItems": 0
        },
        "transcriptArtifactId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceAssetId",
        "language",
        "clock",
        "words",
        "transcriptArtifactId"
      ]
    },
    "pr.captions.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clock": {
          "enum": [
            "timeline"
          ]
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cueKey": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "range": {
                "$ref": "#/$defs/range"
              }
            },
            "required": [
              "cueKey",
              "text",
              "range"
            ]
          },
          "minItems": 0
        },
        "nativeTrackRole": {
          "type": "string",
          "minLength": 1
        },
        "sidecarArtifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "clock",
        "cues",
        "sidecarArtifactIds"
      ]
    },
    "audio.measurement.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceAssetId": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "integratedLufs": {
          "type": "number"
        },
        "truePeakDbtp": {
          "type": "number"
        },
        "residualOffsetSamples": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)$"
        },
        "evidenceKey": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceAssetId",
        "range",
        "sampleRate",
        "channels",
        "evidenceKey",
        "method"
      ]
    },
    "pr.parameter_change.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clipKey": {
          "type": "string",
          "minLength": 1
        },
        "effectMatchName": {
          "type": "string",
          "minLength": 1
        },
        "parameterMatchName": {
          "type": "string",
          "minLength": 1
        },
        "valueEncoding": {
          "enum": [
            "native",
            "linear_amplitude",
            "decibels",
            "normalized",
            "percent"
          ]
        },
        "requestedValue": {
          "oneOf": [
            {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            },
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "brightness_contrast"
                    },
                    "brightness": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 100
                    },
                    "contrast": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "name",
                    "brightness",
                    "contrast"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "gaussian_blur"
                    },
                    "radiusPx": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "repeatEdgePixels": {
                      "type": "boolean",
                      "default": true
                    }
                  },
                  "required": [
                    "name",
                    "radiusPx"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "lumetri_basic"
                    },
                    "exposureEv": {
                      "type": "number",
                      "minimum": -10,
                      "maximum": 10,
                      "default": 0
                    },
                    "contrast": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 100,
                      "default": 0
                    },
                    "saturationPercent": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 200,
                      "default": 100
                    },
                    "temperatureShift": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 100,
                      "default": 0
                    },
                    "tintShift": {
                      "type": "number",
                      "minimum": -100,
                      "maximum": 100,
                      "default": 0
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "Semantic effects mapped by qualified adapters, not guessed localized component names."
            }
          ]
        },
        "nativeValue": {
          "oneOf": [
            {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            },
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "enum": [
                          "brightness",
                          "contrast",
                          "exposureEv",
                          "radiusPx",
                          "repeatEdgePixels",
                          "saturationPercent",
                          "temperatureShift",
                          "tintShift"
                        ]
                      },
                      "parameterMatchName": {
                        "type": "string"
                      },
                      "requestedValue": {
                        "type": [
                          "number",
                          "string",
                          "boolean"
                        ]
                      },
                      "nativeValue": {
                        "type": [
                          "number",
                          "string",
                          "boolean"
                        ]
                      },
                      "readbackValue": {
                        "type": [
                          "number",
                          "string",
                          "boolean"
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "parameterMatchName",
                      "requestedValue",
                      "nativeValue",
                      "readbackValue"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "parameters"
              ],
              "additionalProperties": false
            }
          ]
        },
        "readbackValue": {
          "oneOf": [
            {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            },
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "enum": [
                          "brightness",
                          "contrast",
                          "exposureEv",
                          "radiusPx",
                          "repeatEdgePixels",
                          "saturationPercent",
                          "temperatureShift",
                          "tintShift"
                        ]
                      },
                      "parameterMatchName": {
                        "type": "string"
                      },
                      "requestedValue": {
                        "type": [
                          "number",
                          "string",
                          "boolean"
                        ]
                      },
                      "nativeValue": {
                        "type": [
                          "number",
                          "string",
                          "boolean"
                        ]
                      },
                      "readbackValue": {
                        "type": [
                          "number",
                          "string",
                          "boolean"
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "parameterMatchName",
                      "requestedValue",
                      "nativeValue",
                      "readbackValue"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "parameters"
              ],
              "additionalProperties": false
            }
          ]
        },
        "keyframeTicks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tick"
          },
          "minItems": 0
        }
      },
      "required": [
        "clipKey",
        "effectMatchName",
        "parameterMatchName",
        "valueEncoding",
        "requestedValue",
        "nativeValue",
        "readbackValue",
        "keyframeTicks"
      ]
    },
    "export.completed.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outputKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "completedHostJobId": {
          "type": "string",
          "minLength": 1
        },
        "published": {
          "const": true
        },
        "verificationScope": {
          "enum": [
            "metadata_and_changed_regions",
            "full_decode"
          ]
        }
      },
      "required": [
        "outputKeys",
        "artifactIds",
        "published",
        "verificationScope"
      ]
    },
    "query.inventory.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceSlot": {
          "type": "string",
          "minLength": 1
        },
        "totalReturned": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "resourceSlot",
        "totalReturned",
        "complete"
      ]
    },
    "batch.completed.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "itemKey": {
                "type": "string",
                "minLength": 1
              },
              "operationId": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "SUCCEEDED",
                  "FAILED_NO_EFFECT",
                  "FAILED_WITH_EFFECT",
                  "OUTCOME_UNKNOWN",
                  "CANCELLED_NO_EFFECT",
                  "CANCELLED_WITH_EFFECT",
                  "NOT_ATTEMPTED"
                ]
              },
              "effect": {
                "enum": [
                  "not_applied",
                  "applied",
                  "rolled_back",
                  "partial",
                  "unknown"
                ]
              },
              "errorCode": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "itemKey",
              "status",
              "effect"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "not": {
                        "const": "NOT_ATTEMPTED"
                      }
                    }
                  }
                },
                "then": {
                  "required": [
                    "operationId"
                  ]
                }
              }
            ]
          },
          "minItems": 1
        },
        "allSucceeded": {
          "type": "boolean"
        },
        "requested": {
          "type": "integer",
          "minimum": 0
        },
        "applied": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "notAttempted": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "items",
        "allSucceeded",
        "requested",
        "applied",
        "failed",
        "notAttempted"
      ]
    },
    "project.close.v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestedProjectGuids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "closedProjectGuids": {
          "type": "array",
          "items": {
